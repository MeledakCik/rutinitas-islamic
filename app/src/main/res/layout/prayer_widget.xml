<?xml version="1.0" encoding="utf-8"?>
<!-- Widget lebar/pendek: jadwal dalam lima kolom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayerWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/routine_widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/prayerWidgetKicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/prayer_widget_kicker"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayerWidgetName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prayerWidgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/prayerWidgetCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/prayerWidgetMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <View
        android:id="@+id/prayerWidgetDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_border" />

    <LinearLayout
        android:id="@+id/prayerWidgetTable"
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/prayerWidgetRow0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/prayerWidgetLabel0"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayerWidgetClock0"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayerWidgetRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/prayerWidgetLabel1"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayerWidgetClock1"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayerWidgetRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/prayerWidgetLabel2"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayerWidgetClock2"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayerWidgetRow3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/prayerWidgetLabel3"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayerWidgetClock3"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prayerWidgetRow4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/prayerWidgetLabel4"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/prayerWidgetClock4"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
